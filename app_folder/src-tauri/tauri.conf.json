{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "RAKZ",
  "mainBinaryName": "rakz",
  "version": "0.2.1",
  "identifier": "com.rakz.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "RAKZ",
        "width": 1340,
        "height": 820,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; script-src 'self' tauri:; style-src 'self' 'unsafe-inline' tauri:; img-src 'self' data: asset: http://asset.localhost https://asset.localhost tauri:; font-src 'self' data: tauri:; connect-src 'self' ipc: http://ipc.localhost tauri: https://openrouter.ai; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Local-first mnemonic vault and sustained learning studio",
    "longDescription": "RAKZ transforms isolated memory aids into an interconnected, plain-text (.mns) knowledge graph with graduated active recall, spaced repetition, and cross-subject bridges.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mns"],
        "name": "RAKZ Mnemonic Vault",
        "description": "Plain-text RAKZ mnemonic study file",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
